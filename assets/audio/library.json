{
  "452aa46b60317afceda554157a68d95b48cc469eb1781d55d0e4a540ffd86f4f": {
    "url": "assets/audio/library/452aa46b60317afceda554157a68d95b48cc469eb1781d55d0e4a540ffd86f4f.mp3",
    "duration": 17.822,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 1,
    "parts": [
      {
        "text": "晚安的钟声响了，小镇的窗户一扇扇亮起来。",
        "start": 0.0,
        "duration": 5.777777777777778
      },
      {
        "text": "小熊奥托抬头看天空。星星都在，月亮却不见了。",
        "start": 6.037037037037036,
        "duration": 9.101851851851851
      },
      {
        "text": "“月亮，你藏到哪里去了？”",
        "start": 15.398148148148147,
        "duration": 2.4237685185185196
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 19.2,
    "removedSilenceSeconds": 0.49
  },
  "f31d1a2ce8626c2d7e3b6731ca691bd07cfcb46c3fc5cc58e7ee9db0b6c41f8f": {
    "url": "assets/audio/library/f31d1a2ce8626c2d7e3b6731ca691bd07cfcb46c3fc5cc58e7ee9db0b6c41f8f.mp3",
    "duration": 13.759,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 2,
    "parts": [
      {
        "text": "奥托把红围巾系好，握住一只红气球。",
        "start": 0.0,
        "duration": 4.296296296296296
      },
      {
        "text": "风轻轻吹来，气球把他带离屋顶。",
        "start": 4.555555555555555,
        "duration": 3.333333333333333
      },
      {
        "text": "小镇越来越小，他的勇气却一点点变大。",
        "start": 8.148148148148149,
        "duration": 5.611310185185184
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 14.32,
    "removedSilenceSeconds": 0.0
  },
  "7aa27ee1f01b936a3abed54b95eb94ec3325fff99cbc5e4530460d595b5740d6": {
    "url": "assets/audio/library/7aa27ee1f01b936a3abed54b95eb94ec3325fff99cbc5e4530460d595b5740d6.mp3",
    "duration": 17.664,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 3,
    "parts": [
      {
        "text": "奥托飘过一排排屋顶。暖暖的窗光，像小镇给夜晚写的信。",
        "start": 0.0,
        "duration": 7.259259259259259
      },
      {
        "text": "烟囱边的小猫竖起耳朵。",
        "start": 7.518518518518517,
        "duration": 2.444444444444444
      },
      {
        "text": "“喵，抬头看看吧。月亮也许在更高的地方。”",
        "start": 10.222222222222221,
        "duration": 7.441861111111113
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 18.88,
    "removedSilenceSeconds": 0.32
  },
  "df78a35604db7fd063ebc4818b76becdf9c5117624eb37439ce3ab141a2491c3": {
    "url": "assets/audio/library/df78a35604db7fd063ebc4818b76becdf9c5117624eb37439ce3ab141a2491c3.mp3",
    "duration": 18.045,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 4,
    "parts": [
      {
        "text": "奥托飘进云海。云朵像软软的枕头，轻轻擦过他的脚。",
        "start": 0.0,
        "duration": 8.564814814814815
      },
      {
        "text": "“借过一下，我想找月亮。”",
        "start": 8.824074074074073,
        "duration": 2.6666666666666665
      },
      {
        "text": "风把云推开，露出一条银蓝色的小路。",
        "start": 11.749999999999998,
        "duration": 6.2951250000000005
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 19.84,
    "removedSilenceSeconds": 0.91
  },
  "32d149c5cae60139720af7a6d4062e28ce4689ad64cda1808bc50f9071036140": {
    "url": "assets/audio/library/32d149c5cae60139720af7a6d4062e28ce4689ad64cda1808bc50f9071036140.mp3",
    "duration": 18.095,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 5,
    "parts": [
      {
        "text": "一棵高高的树旁，猫头鹰轻轻转过头。",
        "start": 0.0,
        "duration": 6.185185185185184
      },
      {
        "text": "“别着急，奥托。有时候，安静的朋友也需要一句问候。”",
        "start": 6.444444444444444,
        "duration": 6.731481481481481
      },
      {
        "text": "奥托点点头，把准备好的晚安，放在了心里。",
        "start": 13.435185185185183,
        "duration": 4.657407407407407
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 19.36,
    "removedSilenceSeconds": 0.38
  },
  "aab0800f189947ea2afb6abc759331fb33f1ce60f7018099c7ebb30aaded6428": {
    "url": "assets/audio/library/aab0800f189947ea2afb6abc759331fb33f1ce60f7018099c7ebb30aaded6428.mp3",
    "duration": 17.869,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 6,
    "parts": [
      {
        "text": "一颗小星星眨眨眼，落在奥托身旁。",
        "start": 0.0,
        "duration": 6.268518518518517
      },
      {
        "text": "奥托朝它挥手，继续向更高的云飘去。",
        "start": 6.527777777777777,
        "duration": 3.99074074074074
      },
      {
        "text": "一路闪烁的小星星，像一串小小的路灯，陪着他往前走。",
        "start": 10.777777777777777,
        "duration": 7.090722222222224
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 19.6,
    "removedSilenceSeconds": 0.84
  },
  "7a594e3f379d033f7999d5b261a92772c894f0bbfd051689cbfe3f26b23caf02": {
    "url": "assets/audio/library/7a594e3f379d033f7999d5b261a92772c894f0bbfd051689cbfe3f26b23caf02.mp3",
    "duration": 20.186,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 7,
    "parts": [
      {
        "text": "奥托停在云边，看见一弯藏起来的金光。",
        "start": 0.0,
        "duration": 3.916666666666667
      },
      {
        "text": "“没关系，我陪你。你可以先露出一点点。”",
        "start": 4.175925925925926,
        "duration": 3.944444444444444
      },
      {
        "text": "月亮听见了。云朵后面，慢慢探出一个小小的微笑。",
        "start": 8.37962962962963,
        "duration": 11.796296296296296
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 22.96,
    "removedSilenceSeconds": 1.73
  },
  "9d61542d0790769724baed01e1030d9e1e670cc3fba5b7e6798c513dd05a91d7": {
    "url": "assets/audio/library/9d61542d0790769724baed01e1030d9e1e670cc3fba5b7e6798c513dd05a91d7.mp3",
    "duration": 19.328,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 8,
    "parts": [
      {
        "text": "月亮慢慢走出云朵。金光落在奥托的围巾上，也落进小镇的窗。",
        "start": 0.0,
        "duration": 11.925925925925926
      },
      {
        "text": "奥托笑了，月亮也笑了。",
        "start": 12.185185185185185,
        "duration": 3.5462962962962963
      },
      {
        "text": "有人陪着的时候，试一试就没有那么难。",
        "start": 15.990740740740739,
        "duration": 3.333333333333333
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 20.32,
    "removedSilenceSeconds": 0.01
  },
  "4ec91f2e9eb1e3dc253e5e21df37fe80e54688988be3934362969244edd7a246": {
    "url": "assets/audio/library/4ec91f2e9eb1e3dc253e5e21df37fe80e54688988be3934362969244edd7a246.mp3",
    "duration": 17.079,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 9,
    "parts": [
      {
        "text": "红气球顺着晚风，轻轻往下落。",
        "start": 0.0,
        "duration": 5.703703703703703
      },
      {
        "text": "屋顶、小路和小花园，都披上了月光。",
        "start": 5.962962962962963,
        "duration": 5.111111111111111
      },
      {
        "text": "奥托回头挥手：“明天见，我会记得向你说晚安。”",
        "start": 11.333333333333332,
        "duration": 5.746125000000003
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 18.48,
    "removedSilenceSeconds": 0.59
  },
  "7b63cd595edc3b980aefceb26c9ac38099e43cea7d3c44c7822cf43eed5b53f9": {
    "url": "assets/audio/library/7b63cd595edc3b980aefceb26c9ac38099e43cea7d3c44c7822cf43eed5b53f9.mp3",
    "duration": 20.979,
    "voice": "Serena",
    "engine": "Qwen3-TTS-1.7B-4bit",
    "bookId": "demo-otto",
    "page": 10,
    "parts": [
      {
        "text": "奥托躺进被窝，红气球靠在床边。",
        "start": 0.0,
        "duration": 3.925925925925926
      },
      {
        "text": "月亮安静地守在窗外，星星也慢慢眨着眼。",
        "start": 4.185185185185184,
        "duration": 6.814814814814815
      },
      {
        "text": "晚安，奥托。晚安，月亮。也晚安，正在听故事的你。",
        "start": 11.25925925925926,
        "duration": 9.720115740740741
      }
    ],
    "rhythmVersion": "natural-v3",
    "tempo": 1.08,
    "sourceDuration": 25.44,
    "removedSilenceSeconds": 3.3
  },
